# syntax=docker/dockerfile:1
# Kokoro in the image of an Arandu application, beside Piper or alone.
#
# What this snippet does, and why it looks like this:
#
# * The Kokoro voices are made by docs/kokoro-speak.py, a small Python program
#   that this package starts the way it starts Piper. It needs a Python
#   interpreter and the packages of docs/kokoro-requirements.txt (kokoro-onnx,
#   onnxruntime, numpy and espeak-ng, whose library the espeakng-loader wheel
#   carries). gcr.io/distroless/python3-debian12 is that: Debian 12 glibc,
#   libstdc++ and Python 3.11, no shell, no package manager, non-root. It is the
#   same runtime as docs/Dockerfile.snippet, so one image can hold both engines.
# * Everything is fetched and verified in a build stage. The packages are
#   installed with --require-hashes (every file has its sha256 in
#   kokoro-requirements.txt), and the model and the voices file are checked
#   against a sha256 written here, so a changed file fails the build instead of
#   reaching production. Update the digests when you upgrade a version.
# * Nothing is installed in the runtime image by pip or apt: the packages are
#   copied from the build stage, and the application reaches them with
#   KOKORO_BIN=/opt/kokoro/bin/kokoro-speak and PYTHONPATH=/opt/kokoro (see the
#   README for the matching piper.Config).
# * The first line of kokoro-speak is rewritten to the interpreter of the build
#   stage (/usr/bin/python3, the one the runtime image has), as pip does for the
#   scripts it writes. Outside Docker, point it at your virtual environment.
# * The model is the fp32 one (the reference quality). The int8 model is a third
#   of the size and about twice as fast on a CPU, at some cost in quality: build
#   with --build-arg KOKORO_MODEL=kokoro-v1.0.int8.onnx and listen first.
# * ffmpeg is yours, and only needed for piper.FormatOpus (built with libopus).
#
# Copy kokoro-speak.py and kokoro-requirements.txt from docs/ into the build
# context beside this Dockerfile. It was built and run on arm64 with Docker 29
# (colima): kokoro-speak on a sentence, and the module's TestRealKokoro (a test
# binary built with CGO_ENABLED=0 as the entrypoint) as a non-root user with two
# CPUs. The amd64 packages are the ones PyPI publishes for Python 3.11, with the
# hashes of kokoro-requirements.txt; that architecture was not built here.

FROM debian:bookworm-slim AS kokoro
# kokoro-onnx 0.6.1 (MIT), https://github.com/thewh1teagle/kokoro-onnx
# The model and the voices are Kokoro-82M v1.0 (Apache-2.0, hexgrad/Kokoro-82M),
# converted to ONNX by that project, from its release model-files-v1.0.
ARG KOKORO_MODEL=kokoro-v1.0.onnx
ARG KOKORO_RELEASE=https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0
ARG KOKORO_SHA256_MODEL_FP32=7d5df8ecf7d4b1878015a32686053fd0eebe2bc377234608764cc0ef3636a6c5
ARG KOKORO_SHA256_MODEL_INT8=6e742170d309016e5891a994e1ce1559c702a2ccd0075e67ef7157974f6406cb
ARG KOKORO_SHA256_VOICES=bca610b8308e8d99f32e6fe4197e7ec01679264efed0cac9140fe9c29f1fbf7d

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl python3 python3-pip \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/kokoro
COPY kokoro-requirements.txt kokoro-speak.py ./
RUN pip install --no-cache-dir --break-system-packages --require-hashes --no-deps \
      --target /opt/kokoro -r kokoro-requirements.txt

RUN set -eu; \
    mkdir -p /opt/kokoro/model; \
    case "$KOKORO_MODEL" in \
      kokoro-v1.0.onnx)      model_sha="$KOKORO_SHA256_MODEL_FP32" ;; \
      kokoro-v1.0.int8.onnx) model_sha="$KOKORO_SHA256_MODEL_INT8" ;; \
      *) echo "unknown model $KOKORO_MODEL" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o "/opt/kokoro/model/${KOKORO_MODEL}" "${KOKORO_RELEASE}/${KOKORO_MODEL}"; \
    curl -fsSL -o /opt/kokoro/model/voices-v1.0.bin   "${KOKORO_RELEASE}/voices-v1.0.bin"; \
    echo "${model_sha}  /opt/kokoro/model/${KOKORO_MODEL}"           >  /tmp/model.sha256; \
    echo "${KOKORO_SHA256_VOICES}  /opt/kokoro/model/voices-v1.0.bin" >> /tmp/model.sha256; \
    sha256sum -c /tmp/model.sha256; \
    ln -s "${KOKORO_MODEL}" /opt/kokoro/model/kokoro.onnx

# The program, with the interpreter that has the packages on its first line.
RUN set -eu; \
    mkdir -p /opt/kokoro/bin; \
    { echo '#!/usr/bin/python3'; tail -n +2 kokoro-speak.py; } > /opt/kokoro/bin/kokoro-speak; \
    chmod 0755 /opt/kokoro/bin/kokoro-speak

# The licenses go with the files: each package's own, and the model's (Apache-2.0).
RUN set -eu; \
    mkdir -p /opt/licenses; \
    for d in /opt/kokoro/*.dist-info; do \
      n=$(basename "$d" .dist-info); \
      cp -r "$d/licenses" "/opt/licenses/$n" 2>/dev/null || cp "$d"/LICENSE* "/opt/licenses/$n" 2>/dev/null || true; \
    done; \
    printf '%s\n' 'Kokoro-82M (hexgrad/Kokoro-82M): Apache License 2.0, https://www.apache.org/licenses/LICENSE-2.0' \
      > /opt/licenses/kokoro-82m.txt

FROM gcr.io/distroless/python3-debian12:nonroot
COPY --from=kokoro /opt/kokoro   /opt/kokoro
COPY --from=kokoro /opt/licenses /usr/share/licenses/kokoro
# COPY --from=app    /out/app      /app
# COPY --from=ffmpeg /ffmpeg       /usr/local/bin/ffmpeg   # only for piper.FormatOpus
ENV KOKORO_BIN=/opt/kokoro/bin/kokoro-speak \
    KOKORO_MODEL=/opt/kokoro/model/kokoro.onnx \
    KOKORO_VOICES=/opt/kokoro/model/voices-v1.0.bin \
    KOKORO_PYTHONPATH=/opt/kokoro
# distroless/python3 starts the interpreter; this image starts the application.
# ENTRYPOINT ["/app"]
